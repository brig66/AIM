# -----------------------------------------------------------------------------
# AIM AI Visibility Tracker — Subscriptions App
# Copy this file to .env.local for local development. In production (Vercel),
# paste each of these into Project Settings -> Environment Variables instead
# of ever putting real values in this file or in git.
# -----------------------------------------------------------------------------

# Supabase project (already provisioned) -------------------------------------
# Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://rrmilbbyzulopuesqwic.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_AoSdTTLIgN1MG5A_u5aLKw_frhfD03h

# SECRET. Supabase Dashboard -> Project Settings -> API -> service_role key.
# Grants full database access, bypassing RLS. Server-only, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe -----------------------------------------------------------------------
# SECRET. Stripe Dashboard -> Developers -> API keys -> Secret key.
STRIPE_SECRET_KEY=
# SECRET. Stripe Dashboard -> Developers -> Webhooks -> (the endpoint) -> Signing secret.
STRIPE_WEBHOOK_SECRET=
# Price IDs for the two recurring subscription Prices you create in Stripe
# (Dashboard -> Product catalog -> Add product -> Recurring price -> copy the "price_..." ID).
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_WEEKLY=

# Resend (transactional email) --------------------------------------------------
# SECRET. Resend Dashboard -> API Keys.
RESEND_API_KEY=
# The "from" address for outbound email. Must be on a domain verified in Resend.
RESEND_FROM_EMAIL=AIM AI Visibility <reports@aim-tex.com>

# Cron protection ----------------------------------------------------------------
# SECRET. Any long random string you generate yourself. Vercel Cron sends this
# back as a Bearer token so random people on the internet can't trigger client runs.
CRON_SECRET=

# Cloudflare Turnstile (bot protection on signup) --------------------------------
# Public: safe to expose to the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SECRET. Cloudflare Dashboard -> Turnstile -> your site -> Secret key.
TURNSTILE_SECRET_KEY=

# Admin dashboard (single-operator password gate) --------------------------------
# SECRET. Pick a strong password yourself; this is Brig's login for /admin.
ADMIN_PASSWORD=
# SECRET. Any long random string, used to sign the admin session cookie.
ADMIN_SESSION_SECRET=

# AI engine keys (agency-owned, shared across all clients) -----------------------
# These match the exact env var names already used by the aim-ai-visibility-tracker
# skill, so both the skill and this app read the same keys.
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Base URL of this deployed app (used to build links in emails). Vercel sets
# VERCEL_URL automatically; set this explicitly for your production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
