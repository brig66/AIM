+def _intent_note(m, bn):
+    """One sentence that never quotes a blended rate as if it were the headline."""
+    nb, br = m.get("non_branded"), m.get("branded")
+    if not nb and not br:
+        return (f"Across {m['results']} AI answers this period, {bn} was cited in "
+                f"<b>{m['citation_rate']:g}%</b> and named in <b>{m['mention_rate']:g}%</b>.")
+    out = []
+    if nb:
+        out.append(f"Across <b>{nb['answers']}</b> answers to questions that never name "
+                   f"{bn}, it was cited in <b>{nb['citation_rate']:g}%</b> and named in "
+                   f"<b>{nb['mention_rate']:g}%</b> — this is the number that reflects "
+                   f"winning someone new.")
+    if br:
