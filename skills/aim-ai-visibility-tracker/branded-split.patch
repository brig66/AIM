+def is_branded(prompt: "Prompt", brand: "Entity") -> bool:
+    """Does this prompt name the brand?
+
+    A branded prompt is someone who has already found the company and is asking
+    about it by name. AI nearly always cites a company back to itself for those,
+    so blending them into one citation rate flatters the number: a client with a
+    strong name and no category presence looks visible when they are not.
+
+    An explicit `branded:` in the config always wins. Otherwise the prompt is
+    branded if it names the brand or one of its aliases. Matching is on word
+    boundaries so "Osaki" does not match inside another word, and a `brand` tag
+    is honoured as a fallback for prompts that circle the company without
+    naming it.
+    """
+    if prompt.branded is not None:
+        return bool(prompt.branded)
+    text = prompt.text.lower()
+    for alias in brand.aliases or [brand.name]:
+        a = str(alias).strip().lower()
+        if a and re.search(r"\b" + re.escape(a) + r"\b", text):
+            return True
+    return "brand" in [str(t).lower() for t in (prompt.tags or [])]
+
