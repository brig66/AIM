+                   f"it was cited in <b>{br['citation_rate']:g}%</b>; reported separately "
+                   f"because a branded question is someone who has already found them.")
+    if nb and br:
+        out.append(f"Blended across all {m['results']} answers the citation rate reads "
+                   f"<b>{m['citation_rate']:g}%</b>.")
+    return " ".join(out)
