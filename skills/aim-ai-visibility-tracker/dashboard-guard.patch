+GUARD_URL = "https://hfmvugxpwgagvxsjbjfn.supabase.co/functions/v1/tracker-guard"
+
+class DashboardClientError(SystemExit):
+    pass
+
+def dashboard_guard(cfg: "Config") -> None:
+    domains = sorted({d.strip().lower() for d in [cfg.primary_domain, *cfg.brand.domains] if d and d.strip()})
+    if not domains:
+        raise DashboardClientError(
+            f"STOPPED - no AI engine was queried and nothing was spent.\n"
+            f"The config for {cfg.client} lists no brand domains, so it can't be checked against "
+            f"the AIM Analytics Dashboard. Add the client's website under brand.domains and run again.")
+    req = urllib.request.Request(GUARD_URL, data=json.dumps({"domains": domains}).encode(),
