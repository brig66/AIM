+            f"and the monthly report. Use those numbers instead of running the tracker here.")
+    if answer.get("dashboard_client") is not False:
+        raise DashboardClientError(
+            f"STOPPED - no AI engine was queried and nothing was spent.\n"
+            f"The AIM Analytics Dashboard check returned an unexpected answer for {cfg.client}. "
